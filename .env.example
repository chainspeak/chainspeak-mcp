# --- chains -------------------------------------------------------------------
# One RPC endpoint per chain: RPC_URL_<CHAIN>. Configure as many as you want —
# tools then take a chain parameter, and account/transaction/status queries read
# ALL configured chains by default. URLs may embed a provider key: never commit
# this file, and the server never logs the URL.
#
# Known chains: ethereum, base, op-mainnet, arbitrum-one, polygon, bnb-smart-chain,
# gnosis, linea-mainnet, sepolia, holesky. Short aliases (op, arbitrum, bnb, linea)
# and chain ids (RPC_URL_8453) work too.
#
# Historical-state queries need ARCHIVE-capable endpoints. Public endpoints vary:
# eth.drpc.org (free) is archive, ethereum-rpc.publicnode.com is NOT. drpc's free
# tier also caps JSON-RPC batches at 3 (handled). Paid providers (Ankr, QuickNode,
# Alchemy) are archive on every chain and are what this is designed for.
RPC_URL_ETHEREUM=https://eth.drpc.org
RPC_URL_BASE=https://base.drpc.org
RPC_URL_ARBITRUM=https://arbitrum.drpc.org
# RPC_URL_OP_MAINNET=https://optimism.drpc.org
# RPC_URL_POLYGON=https://polygon.drpc.org

# Optional per-chain second endpoint; enables viem's fallback transport.
# RPC_URL_ETHEREUM_FALLBACK=https://ethereum-rpc.publicnode.com
# RPC_URL_BASE_FALLBACK=https://base-rpc.publicnode.com

# The chain used when a tool call does not name one (default ethereum). Must be
# one of the chains configured above, otherwise the first one wins.
# CHAIN=ethereum

# ENS names work on EVERY configured chain, but resolution always happens on
# ethereum, so configure RPC_URL_ETHEREUM if you want names rather than only
# 0x addresses. Without it, names fail with a clear error.

# Single-chain shorthand, still supported: ETH_RPC_URL is the endpoint for CHAIN.
# ETH_RPC_URL=https://eth.drpc.org
# ETH_RPC_URL_FALLBACK=

# Per-request timeout in milliseconds (default 10000).
# ETH_RPC_TIMEOUT_MS=10000

# pino level: debug | info | warn | error (default info). Logs go to stderr.
# LOG_LEVEL=info

# --- HTTP server / worker only; the stdio entry ignores these -------------------
# Optional bearer token (min 16 chars). When set, clients must send it; when unset the
# server runs UNAUTHENTICATED (a warning is logged). Generate one:
#   openssl rand -hex 24
# MCP_AUTH_TOKEN=
# HTTP_PORT=3000
# HTTP_HOST=0.0.0.0
